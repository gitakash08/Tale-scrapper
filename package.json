{
  "name": "r-tale-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone multi-source KR/CN drama, TV show, and movie scraper worker.",
  "bin": { "r-tale-scraper": "src/worker.js" },
  "scripts": {
    "migrate": "node src/worker.js migrate",
